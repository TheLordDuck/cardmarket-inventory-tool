# Copy this file to .env and fill in your values. Never commit the real .env.

# --- Direct-browser Chrome connection ---
# Playwright attaches to your own already-running Chrome over this CDP URL
# instead of launching a new browser. The CLI launches Chrome itself (with a
# dedicated profile, see README) if nothing's listening here yet.
CARDMARKET_CDP_URL=http://localhost:9222
# Random delay range (seconds) between simulated actions (clicks/fills).
BROWSER_ACTION_DELAY_MIN_SECONDS=1.5
BROWSER_ACTION_DELAY_MAX_SECONDS=4.0
# Optional: lets the CLI fill in your username/password on Cardmarket's own
# login form for you. You still have to complete 2FA/CAPTCHA yourself in the
# browser window -- that step can't be automated. Treat these like your real
# password, because they are one: never commit .env (already gitignored) and
# don't paste it anywhere else.
CARDMARKET_USERNAME=
CARDMARKET_PASSWORD=
# Only needed if Chrome isn't at this default install path.
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Defaults to <project>/.cardmarket-browser-profile (already gitignored) if left blank.
CARDMARKET_BROWSER_PROFILE_DIR=
# After auto-filling your username/password, how many seconds to keep
# polling for you to finish 2FA/verification in the browser before giving
# up -- lets a command continue automatically once you're done instead of
# needing to rerun it.
LOGIN_WAIT_TIMEOUT_SECONDS=300

# --- Pricing (used by `reprice`) ---
# new_price = cardmarket_7_day_trend_price(eur) * PRICE_MULTIPLIER * condition_multiplier,
# then clamped and rounded. Condition multipliers live in src/config.py.
# 1.0 = list at exactly the 7-day average trend price (e.g. 0.95 would list 5% below it).
PRICE_MULTIPLIER=1.0
MIN_PRICE=0.05
# Leave MAX_PRICE empty for no upper cap.
MAX_PRICE=
# Round to the nearest multiple of this (Cardmarket prices are typically 2-decimal EUR).
PRICE_STEP=0.01

# Cap how many rows get a changed price per run, so you can roll out
# repricing gradually instead of relisting your whole stock at once.
# 0 = no limit. Overridable per-run with --limit.
MAX_CHANGES_PER_RUN=0
